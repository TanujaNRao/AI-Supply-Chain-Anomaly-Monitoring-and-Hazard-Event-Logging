    {
      "parameters": {
        "jsCode": "function band(score) {\n  if (score <= 45) return \"Low\";\n  if (score <= 62) return \"Medium\";\n  if (score <= 74) return \"High\";\n  return \"Critical\";\n}\n\nconst aiItems = $input.all();\nconst sourceItems = $('Unified Operations Data Engine').all();\n\nreturn aiItems.map((item, i) => {\n\n  const d = sourceItems[i]?.json || {};\n\n  const text = item.json.output || \"\";\n\n  // Extract Event Category\n  const eventCategory =\n    (text.match(/Event Category:\\s*([\\s\\S]*?)Incident Summary:/i)?.[1] || \"Unclassified\").trim();\n\n  // Extract Incident Summary\n  const incidentSummary =\n    (text.match(/Incident Summary:\\s*([\\s\\S]*?)Recommended Actions:/i)?.[1] || \"\").trim();\n\n  // Extract Recommendations\n  const recommendation =\n    (text.match(/Recommended Actions:\\s*([\\s\\S]*)/i)?.[1] || \"\").trim();\n\n  const hazard_score = Number(d.hazard_score) || 0;\n  const stock_score = Number(d.stock_score) || 0;\n\n  const combined_score = Math.max(hazard_score, stock_score);\n\n  return {\n\n    json: {\n\n      event_id:\n        \"EVT-\" +\n        Math.random().toString(36).substring(2, 8).toUpperCase(),\n\n      shipment_id: d.shipment_key,\n\n      log_id: d.log_id,\n\n      facility_id: d.facility_id,\n\n      hazard_type: d.hazard_type,\n\n      shipment_status: d.shipment_status,\n\n      severity_level: d.severity_level,\n\n      hazard_score,\n\n      stock_score,\n\n      combined_score,\n\n      business_priority: band(combined_score),\n\n      event_category: eventCategory,\n\n      incident_summary: incidentSummary,\n\n      recommendation: recommendation,\n\n      assigned_team:\n        (hazard_score > 0 && stock_score > 0)\n          ? \"Safety + Logistics (Joint Response)\"\n          : hazard_score > 0\n            ? \"Safety Team\"\n            : \"Logistics Team\",\n\n      notification_status: \"Pending\",\n\n      event_status: \"Open\",\n\n      processed_timestamp: new Date().toISOString()\n\n    }\n\n  };\n\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        -16
      ],
      "id": "23a6b711-2178-47d8-a00e-0cf019509dfa",
