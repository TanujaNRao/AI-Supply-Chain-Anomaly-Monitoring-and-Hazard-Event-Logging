      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => {\n  const d = item.json;\n  const rawBand = d['stock_risk_band'];\n  const stock_band = rawBand === 'Very Critical' ? 'Critical' : rawBand;\n  return {\n    json: {\n      shipment_key: d['shipment_key'] || d['Shipment ID'],\n      stock_score: Number(d['shipment_score']) || 0,\n      stock_band,\n      stock_recommendation: d['recommendation'] || null,\n      carrier: d['carrier'],\n      origin: d['origin'],\n      destination_facility: d['destination_facility'],\n      delay_days: d['delay_days'],\n      goods_condition: d['goods_condition'],\n      temperature_excursion: d['temperature_excursion'],\n      inventory_risk: d['inventory_risk'],\n      shipment_status: d['status']\n    }\n  };\n});"
      },
